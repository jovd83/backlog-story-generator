{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentskills.io/schemas/backlog-story-generator/story.schema.json",
  "title": "Backlog Story Generator Story Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "storyId",
    "epicFeature",
    "priority",
    "storyPoints",
    "status",
    "userStory",
    "context",
    "functionalBusinessReferences",
    "acceptanceCriteria"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5
    },
    "storyId": {
      "type": "string",
      "pattern": "^US-\\d{3,}$"
    },
    "epicFeature": {
      "type": "string",
      "minLength": 3
    },
    "priority": {
      "type": "string",
      "enum": ["Critical", "High", "Medium", "Low"]
    },
    "storyPoints": {
      "type": "string",
      "enum": ["1", "2", "3", "5", "8", "13"]
    },
    "status": {
      "type": "string",
      "enum": ["Proposed", "Ready", "In Progress", "Done"]
    },
    "userStory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asA", "iWant", "soThat"],
      "properties": {
        "asA": {
          "type": "string",
          "minLength": 2
        },
        "iWant": {
          "type": "string",
          "minLength": 5
        },
        "soThat": {
          "type": "string",
          "minLength": 5
        }
      }
    },
    "context": {
      "type": "string",
      "minLength": 15
    },
    "functionalBusinessReferences": {
      "type": "string",
      "minLength": 3
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario", "given", "when", "then"],
        "properties": {
          "scenario": {
            "type": "string",
            "minLength": 3
          },
          "given": {
            "type": "string",
            "minLength": 3
          },
          "when": {
            "type": "string",
            "minLength": 3
          },
          "then": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "businessRules": {
      "type": "string"
    },
    "scopeNotes": {
      "type": "string"
    },
    "dependencies": {
      "type": "string"
    },
    "nonFunctionalNotes": {
      "type": "string"
    },
    "ux": {
      "type": "string"
    },
    "diagrams": {
      "type": "string"
    },
    "testingNotes": {
      "type": "string"
    },
    "openQuestions": {
      "type": "string"
    },
    "sourceTraceability": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "implementationNotes": {
      "type": "string"
    },
    "dataModelFields": {
      "type": "string"
    },
    "webAppUiInteraction": {
      "type": "string"
    },
    "apiRestContract": {
      "type": "string"
    },
    "functionalRequirements": {
      "type": "string"
    },
    "nonFunctionalRequirements": {
      "type": "string"
    },
    "technicalConsiderations": {
      "type": "string"
    },
    "qaTestingStrategy": {
      "type": "string"
    },
    "unitTests": {
      "type": "string"
    },
    "integrationTests": {
      "type": "string"
    },
    "e2eTests": {
      "type": "string"
    },
    "regressionSanityTests": {
      "type": "string"
    },
    "testExecutionPlan": {
      "type": "string"
    },
    "definitionOfDone": {
      "type": "string"
    },
    "sourcePath": {
      "type": "string"
    }
  }
}
